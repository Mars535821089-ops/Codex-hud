+#[tokio::test]
+async fn unified_mode_shortcut_rejections_restore_prior_collaboration_mode() -> Result<()> {
+    use codex_protocol::config_types::ModeKind;
+
+    for experimental_api in [false, true] {
+        for (previous, requested) in [
+            (ModeKind::Default, ModeKind::Plan),
+            (ModeKind::Plan, ModeKind::Default),
+        ] {
+            let (mut app, mut events, _ops) = make_test_app_with_channels().await;
+            let home = tempdir()?;
+            app.config.codex_home = home.path().to_path_buf().abs();
+            let config_path = home.path().join("config.toml");
+            let original_bytes = b"# synthetic permission rollback fixture\n";
+            std::fs::write(&config_path, original_bytes)?;
+            let thread_id = ThreadId::new();
+            app.active_thread_id = Some(thread_id);
+            app.chat_widget
+                .handle_thread_session_quiet(test_thread_session(
+                    thread_id,
+                    app.config.cwd.to_path_buf(),
+                ));
+            let original_permissions =
+                RuntimePermissionProfileOverride::from_config(app.chat_widget.config_ref());
+            app.chat_widget
+                .set_collaboration_mode_kind_from_user_action(previous);
+            assert_eq!(app.chat_widget.active_collaboration_mode_kind(), previous);
+            // The key handler updates the displayed mode before the app event.
+            app.chat_widget
+                .set_collaboration_mode_kind_from_user_action(requested);
+            assert_eq!(app.chat_widget.active_collaboration_mode_kind(), requested);
+            let client = crate::start_embedded_app_server_with(
+                Arg0DispatchPaths::default(),
+                app.config.clone(),
+                Vec::new(),
+                LoaderOverrides::without_managed_config_for_tests(),
+                /*strict_config*/ false,
+                CloudConfigBundleLoader::default(),
+                codex_feedback::CodexFeedback::new(),
+                /*log_db*/ None,
+                /*state_db*/ None,
+                Arc::clone(&app.environment_manager),
+                Default::default(),
+                |mut args| {
+                    args.experimental_api = experimental_api;
+                    codex_app_server_client::InProcessAppServerClient::start(args)
+                },
+            )
+            .await?;
+            let mut server = AppServerSession::new(
+                crate::backend_id::BackendId::new(),
+                codex_app_server_client::AppServerClient::InProcess(client),
+                crate::app_server_session::ThreadParamsMode::Embedded,
+            );
+            while events.try_recv().is_ok() {}
+            // No thread was registered: exercise real unsupported/RPC-error paths.
+            app.apply_permission_shortcut_with_mode(
+                &mut server,
+                thread_id,
+                read_only_selection(),
+                Some(requested),
+                Some(previous),
+            )
+            .await;
+            assert_eq!(app.chat_widget.active_collaboration_mode_kind(), previous);
+            assert_eq!(
+                RuntimePermissionProfileOverride::from_config(app.chat_widget.config_ref()),
+                original_permissions
+            );
+            assert!(!app.agents_overview.requested_permission_profiles.contains_key(&thread_id));
+            assert_eq!(std::fs::read(&config_path)?, original_bytes);
+            server.shutdown().await?;
+        }
+    }
+    Ok(())
+}
