+            PermissionProfile::workspace_write(),
+            ActivePermissionProfile::new(":workspace"),
+        ))
+        .expect("set default permissions");
+
+    chat.handle_key_event(KeyEvent::from(KeyCode::BackTab));
+    let (plan, plan_mode) = next_permission_selection(&mut rx);
+    assert_eq!(plan_mode, Some(ModeKind::Plan));
+    assert_eq!(
+        (
+            plan.profile_id.as_str(),
+            plan.approval_policy,
+            plan.display_label.as_str()
