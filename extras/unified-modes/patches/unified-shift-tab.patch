 use super::*;

 impl ChatWidget {
+    /// Make Shift+Tab behave as one session-scoped mode switch:
+    /// Default -> Plan -> Full Access -> Default.
+    pub(super) fn handle_unified_mode_shortcut(&mut self, key_event: KeyEvent) -> bool {
+        if !matches!(
+            key_event,
+            KeyEvent {
+                code: KeyCode::BackTab,
+                kind: KeyEventKind::Press,
+                ..
+            }
+        ) {
+            return false;
+        }
+        if !self.collaboration_modes_enabled()
+            || self.bottom_pane.is_task_running()
+            || !self.bottom_pane.no_modal_or_popup_active()
+        {
+            return false;
+        }
+        if self.permission_shortcut_pending {
+            return true;
+        }
+        if self.blocks_direct_input {
+            self.add_error_message(PARENT_OWNED_INPUT_MESSAGE.to_string());
+            return true;
+        }
+        let Some(thread_id) = self.thread_id else {
+            return true;
+        };
+
+        let current_approval =
+            AskForApproval::from(self.config.permissions.approval_policy.value());
+        let current_profile = self.config.permissions.permission_profile();
+        let full_access = current_approval == AskForApproval::Never
+            && matches!(current_profile, PermissionProfile::Disabled);
+        let previous_collaboration_mode = self.active_mode_kind();
+        let (preset_id, display_label, collaboration_mode) =
+            if self.active_mode_kind() == ModeKind::Plan {
+                ("full-access", "Full Access", ModeKind::Default)
+            } else if full_access {
+                ("auto", "Default", ModeKind::Default)
+            } else {
+                ("read-only", "Plan", ModeKind::Plan)
+            };
+
+        let Some(preset) = builtin_approval_presets()
+            .into_iter()
+            .find(|preset| preset.id == preset_id)
+        else {
+            self.add_error_message(format!(
+                "Internal error: missing the '{preset_id}' permission preset."
+            ));
+            return true;
+        };
+        let approval = AskForApproval::from(preset.approval);
+        let reviewer = ApprovalsReviewer::User;
+        let requirements = self.config.config_layer_stack.requirements();
+        if let Some(reason) = self.permission_mode_disabled_reason(&preset, approval) {
+            self.add_info_message(reason, /*hint*/ None);
+            return true;
+        }
+        if let Err(err) = requirements.approvals_reviewer.can_set(&reviewer) {
+            self.add_info_message(err.to_string(), /*hint*/ None);
+            return true;
+        }
+        if requirements.auto_review_required_for_model(self.current_model()) {
+            self.add_info_message(
+                "This model requires automatic approval review, so this mode is unavailable."
+                    .to_string(),
+                /*hint*/ None,
+            );
+            return true;
+        }
+
+        self.permission_shortcut_pending = true;
+        self.set_collaboration_mode_kind_from_user_action(collaboration_mode);
+        self.app_event_tx.send(AppEvent::ApplyPermissionShortcut {
+            thread_id,
+            selection: PermissionProfileSelection {
+                profile_id: preset.active_permission_profile.id,
+                approval_policy: Some(approval),
+                approvals_reviewer: Some(reviewer),
+                display_label: display_label.to_string(),
+            },
+            collaboration_mode: Some(collaboration_mode),
+            rollback_collaboration_mode: Some(previous_collaboration_mode),
+        });
+        true
+    }
