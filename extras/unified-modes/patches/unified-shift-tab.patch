+fn next_permission_selection(
+    rx: &mut tokio::sync::mpsc::UnboundedReceiver<AppEvent>,
+) -> (PermissionProfileSelection, Option<ModeKind>) {
+    while let Ok(event) = rx.try_recv() {
+        if let AppEvent::ApplyPermissionShortcut {
+            selection,
+            collaboration_mode,
+            ..
+        } = event
+        {
+            return (selection, collaboration_mode);
+        }
+    }
+    panic!("expected a permission selection");
+}
+
+#[tokio::test]
+async fn shift_tab_cycles_default_plan_full_access_as_session_modes() {
+    let (mut chat, mut rx, _op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    let thread_id = ThreadId::new();
+    chat.thread_id = Some(thread_id);
+    chat.config.approvals_reviewer = User;
+    chat.config
+        .permissions
+        .set_permission_profile_from_session_snapshot(PermissionProfileSnapshot::active(
+            PermissionProfile::workspace_write(),
+            ActivePermissionProfile::new(":workspace"),
+        ))
+        .expect("set default permissions");
+
+    chat.handle_key_event(KeyEvent::from(KeyCode::BackTab));
+    let (plan, plan_mode) = next_permission_selection(&mut rx);
+    assert_eq!(plan_mode, Some(ModeKind::Plan));
+    assert_eq!(
+        (
+            plan.profile_id.as_str(),
+            plan.approval_policy,
+            plan.display_label.as_str()
+        ),
+        (":read-only", Some(AskForApproval::OnRequest), "Plan")
+    );
+
+    chat.complete_permission_shortcut(thread_id);
+    chat.config
+        .permissions
+        .set_permission_profile_from_session_snapshot(PermissionProfileSnapshot::active(
+            PermissionProfile::read_only(),
+            ActivePermissionProfile::new(":read-only"),
+        ))
+        .expect("set plan permissions");
+    chat.set_collaboration_mode_kind_from_user_action(ModeKind::Plan);
+    chat.handle_key_event(KeyEvent::from(KeyCode::BackTab));
+    let (full_access, full_access_mode) = next_permission_selection(&mut rx);
+    assert_eq!(full_access_mode, Some(ModeKind::Default));
+    assert_eq!(
+        (
+            full_access.profile_id.as_str(),
+            full_access.approval_policy,
+            full_access.display_label.as_str()
+        ),
+        (
+            BUILT_IN_PERMISSION_PROFILE_DANGER_FULL_ACCESS,
+            Some(AskForApproval::Never),
+            "Full Access"
+        )
+    );
+
+    chat.complete_permission_shortcut(thread_id);
+    chat.config
+        .permissions
+        .set_permission_profile_from_session_snapshot(PermissionProfileSnapshot::active(
+            PermissionProfile::Disabled,
+            ActivePermissionProfile::new(BUILT_IN_PERMISSION_PROFILE_DANGER_FULL_ACCESS),
+        ))
+        .expect("set full-access permissions");
+    chat.config
+        .permissions
+        .approval_policy
+        .set(AskForApproval::Never.to_core())
+        .expect("set full-access approval policy");
+    chat.set_collaboration_mode_kind_from_user_action(ModeKind::Default);
+    chat.handle_key_event(KeyEvent::from(KeyCode::BackTab));
+    let (default, default_mode) = next_permission_selection(&mut rx);
+    assert_eq!(default_mode, Some(ModeKind::Default));
+    assert_eq!(
