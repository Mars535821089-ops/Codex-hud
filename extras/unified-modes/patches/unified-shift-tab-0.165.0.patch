+    pub(super) async fn apply_permission_shortcut_with_mode(
+        &mut self,
+        app_server: &mut AppServerSession,
+        thread_id: ThreadId,
+        selection: PermissionProfileSelection,
+        collaboration_mode: Option<ModeKind>,
+        rollback_collaboration_mode: Option<ModeKind>,
+    ) {
+        if self.current_displayed_thread_id() != Some(thread_id)
+            || self.chat_widget.thread_id() != Some(thread_id)
+        {
+            self.chat_widget.complete_permission_shortcut(thread_id);
+            return;
+        }
+        if let Some(mode) = collaboration_mode {
+            self.chat_widget
+                .set_collaboration_mode_kind_from_user_action(mode);
+        }
+        self.select_permission_profile(app_server, selection).await;
+        if let Some(mode) = rollback_collaboration_mode {
+            // The permission flow is server-backed and may reject the request. The
+            // next server/session update will correct the collaboration mask; keep
+            // the optimistic UI state only until then.
+            let _ = mode;
+        }
+        self.chat_widget.complete_permission_shortcut(thread_id);
+    }
 }
