{
  "language": "zh-Hans",
  "lineLayout": "expanded",
  "pathLevels": 1,
  "elementOrder": ["project", "context", "usage", "tools"],
  "display": {
    "showModel": true,
    "showProject": true,
    "showContextBar": true,
    "contextValue": "percent",
    "mergeGroups": [["project", "context"]],
    "showTools": true,
    "toolsMaxVisible": 8,
    "showAgents": false,
    "showTodos": false,
    "showSessionTokens": true,
    "showDuration": true,
    "showUsage": true,
    "usageBarEnabled": true,
    "usageCompact": true,
    "sevenDayThreshold": 0,
    "showResetLabel": true,
    "showPromptCache": false,
    "showMemoryUsage": false,
    "showConfigCounts": false,
    "showCost": false,
    "showSpeed": false,
    "showClaudeCodeVersion": false,
    "showEffortLevel": true,
    "showOutputStyle": false,
    "showAddedDirs": false,
    "customLine": "专注当下，持续迭代。",
    "customLinePosition": "first"
  },
  "gitStatus": {
    "enabled": true,
    "showDirty": true,
    "showAheadBehind": false,
    "showFileStats": false
  },
  "colors": {
    "context": "green",
    "usage": "brightBlue",
    "warning": "yellow",
    "usageWarning": "brightMagenta",
    "critical": "red",
    "model": "cyan",
    "project": "yellow",
    "git": "magenta",
    "gitBranch": "cyan",
    "label": "dim",
    "custom": "#FF8C00",
    "barFilled": "█",
    "barEmpty": "░"
  }
}
